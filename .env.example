APP_NAME="QC Admission"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database utama app ────────────────────────────────────────────────────────
# Lokal: DB_CONNECTION=mysql | Produksi RS: DB_CONNECTION=sqlsrv
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qc_admission
DB_USERNAME=root
DB_PASSWORD=

# Tambahan untuk SQL Server (aktif jika DB_CONNECTION=sqlsrv)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ── DB RSUS — SQL Server data pasien (koneksi terpisah, selalu sqlsrv) ────────
# Aktif jika RSUS_DB_ENABLED=true
RSUS_DB_HOST=127.0.0.1
RSUS_DB_PORT=1433
RSUS_DB_DATABASE=RSUS
RSUS_DB_USERNAME=sa
RSUS_DB_PASSWORD=
RSUS_DB_ENCRYPT=false
RSUS_DB_TRUST_SERVER_CERTIFICATE=true

# ── Session & Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Keycloak SSO ──────────────────────────────────────────────────────────────
# SSO_ENABLED=true → tombol SSO aktif di login, butuh KEYCLOAK_* terisi
SSO_ENABLED=false
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=qc-admission
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/auth/keycloak/callback"
KEYCLOAK_CACHE_TTL=60
KEYCLOAK_TIMEOUT=5

# ── KPI API — daftar petugas Customer Care ────────────────────────────────────
KPI_API_URL=https://kpi.urip.care/api
KPI_USERNAME=admin
KPI_PASSWORD=
KPI_DEPARTEMEN="Customer Care"

# ── Bed Management IGD API ────────────────────────────────────────────────────
# BED_IGD_ENABLED=true → pakai API. false → fallback RSUS DB atau mock
BED_IGD_ENABLED=false
BED_IGD_API_URL=
BED_IGD_USERNAME=
BED_IGD_PASSWORD=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# RSUS_DB_ENABLED=true → query pasien ke SQL Server RSUS. false → mock
RSUS_DB_ENABLED=false

# ── Redis (opsional) ──────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rsus.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
