APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qc_admission
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── KPI API (Pegawai Customer Care) ──────────────────────────────────────────
KPI_API_URL=https://kpi.urip.care/api
KPI_USERNAME=admin
KPI_PASSWORD=password123
KPI_DEPARTEMEN="Customer Care"

# ── DB RSUS (SQL Server — Patient Data) ──────────────────────────────────────
RSUS_DB_HOST=127.0.0.1
RSUS_DB_PORT=1433
RSUS_DB_DATABASE=RSUS
RSUS_DB_USERNAME=sa
RSUS_DB_PASSWORD=
RSUS_DB_ENCRYPT=false
RSUS_DB_TRUST_SERVER_CERTIFICATE=true

# ── Feature Flags ─────────────────────────────────────────────────────────────
# SSO_ENABLED=true  → tombol SSO muncul di halaman login, Keycloak aktif
# SSO_ENABLED=false → login lokal saja
SSO_ENABLED=false

# RSUS_DB_ENABLED=true  → query pasien langsung ke SQL Server RSUS
# RSUS_DB_ENABLED=false → fallback mock data (untuk dev/lokal)
RSUS_DB_ENABLED=false

# ── Keycloak SSO (aktif jika SSO_ENABLED=true) ────────────────────────────────
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=qc-admission
KEYCLOAK_CLIENT_SECRET=

# ── Bed Management IGD ────────────────────────────────────────────────────────
BED_MANAGEMENT_URL=
BED_MANAGEMENT_TOKEN=
