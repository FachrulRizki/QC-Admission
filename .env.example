APP_NAME="QC Admission"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database utama app ────────────────────────────────────────────────────────
# Lokal dev: DB_CONNECTION=mysql | Produksi RS: DB_CONNECTION=sqlsrv
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qc_admission
DB_USERNAME=root
DB_PASSWORD=

# Tambahan untuk SQL Server (aktif jika DB_CONNECTION=sqlsrv)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ── DB RSUS — SQL Server data pasien (koneksi terpisah, selalu sqlsrv) ────────
# Aktif jika RSUS_DB_ENABLED=true
RSUS_DB_HOST=127.0.0.1
RSUS_DB_PORT=1433
RSUS_DB_DATABASE=RSUS
RSUS_DB_USERNAME=sa
RSUS_DB_PASSWORD=
RSUS_DB_ENCRYPT=false
RSUS_DB_TRUST_SERVER_CERTIFICATE=true

# ── Session & Cache ───────────────────────────────────────────────────────────
AUTH_PASSWORD_RESET_TOKEN_TABLE=qcw_password_reset_tokens

SESSION_TABLE=qcw_sessions
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Keycloak SSO (wajib diisi untuk produksi) ─────────────────────────────────
KEYCLOAK_BASE_URL=https://sso.rsus.id/auth
KEYCLOAK_REALM=rsus
KEYCLOAK_CLIENT_ID=qc-admission
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/auth/keycloak/callback"
KEYCLOAK_CACHE_TTL=60
KEYCLOAK_TIMEOUT=5
KEYCLOAK_ROLE_PERMISSION_MAP=

# ── KPI API — daftar petugas Customer Care ────────────────────────────────────
KPI_API_URL=https://kpi.urip.care/api
KPI_USERNAME=admin
KPI_PASSWORD=
KPI_DEPARTEMEN="Customer Care"
KPI_TOKEN_CACHE_MINUTES=55

# ── Bed Management IGD API ────────────────────────────────────────────────────
# BED_IGD_ENABLED=true  → pakai API eksternal
# BED_IGD_ENABLED=false → fallback ke RSUS DB, lalu mock
#
# BED_IGD_AUTH_MODE:
#   passthrough → forward token Keycloak user yang login (RECOMMENDED)
#                 Tidak perlu credential apapun. Token SSO user dikirim langsung
#                 ke API Bed IGD untuk divalidasi mereka ke Keycloak.
#                 Butuh SSO_ENABLED=true agar token tersedia di session.
#   keycloak    → client_credentials service account (pakai KEYCLOAK_CLIENT_ID/SECRET)
#                 Cocok untuk background job / cron tanpa user session.
#   login       → POST /auth/login ke API Bed IGD pakai BED_IGD_USERNAME/PASSWORD
#   static      → token tetap dari BED_IGD_STATIC_TOKEN
#
# BED_IGD_UPDATE_PATH: endpoint update status bed, default /bed/release/trigger
BED_IGD_ENABLED=false
BED_IGD_API_URL=
BED_IGD_AUTH_MODE=passthrough
BED_IGD_UPDATE_MODE=direct
BED_IGD_UPDATE_PATH=/bed/release/trigger

# ── Feature Flags ─────────────────────────────────────────────────────────────
# RSUS_DB_ENABLED=true → query pasien & bed IGD ke SQL Server RSUS. false → mock
RSUS_DB_ENABLED=false

# ── Redis (opsional, untuk cache & session di produksi) ───────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rsus.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
