APP_NAME="QC Admission"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-server-ip-or-domain
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database utama app
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=qc_admission
DB_USERNAME=sa
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Untuk koneksi MySQL (aktif jika DB_CONNECTION=mysql)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=qc_admission
# DB_USERNAME=root
# DB_PASSWORD=

# DB RSUS — SQL Server data pasien
RSUS_DB_ENABLED=true
RSUS_DB_HOST=127.0.0.1
RSUS_DB_PORT=1433
RSUS_DB_DATABASE=DB_RSUS
RSUS_DB_USERNAME=sa
RSUS_DB_PASSWORD=
RSUS_DB_ENCRYPT=no
RSUS_DB_TRUST_SERVER_CERTIFICATE=yes

# Session & Cache─
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=qcw_sessions

CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Keycloak SSO (wajib diisi untuk produksi)─
SSO_ENABLED=true
KEYCLOAK_BASE_URL=https://sso.example.com/auth
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=qc-admission
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=${APP_URL}/auth/keycloak/callback
KEYCLOAK_CACHE_TTL=60
KEYCLOAK_TIMEOUT=5

# KPI API — daftar petugas Customer Care
KPI_API_URL=https://kpi.urip.care/api
KPI_USERNAME=admin
KPI_PASSWORD=
KPI_DEPARTEMEN="Customer Care"
KPI_TOKEN_CACHE_MINUTES=55

# Bed Management IGD API 
BED_IGD_ENABLED=true
BED_IGD_API_URL=http://your-bed-igd-api-host/api
BED_IGD_AUTH_MODE=passthrough
BED_IGD_UPDATE_MODE=direct
BED_IGD_UPDATE_PATH=/bed/release/trigger
BED_IGD_TOKEN_CACHE_MINUTES=55

# Redis (opsional, untuk cache & session di produksi)─
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5174
